# Синхронизация (pnpm sync) и сборка сайта (pnpm build). В GitHub Actions — секреты репозитория.

# Пароль сайта: данные шифруются им при сборке. Не задан — public/data.json открытым (только локально).
# DATA_PASSWORD=

# Региональные отделения ФСП (pnpm sync regional):
# сервисный ключ приложения VK — без него группы VK пропускаются, собираются только Telegram-каналы.
# VK_SERVICE_TOKEN=
