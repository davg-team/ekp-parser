# Локально всё хранится в .data/dataset.json. Для работы с облачным бакетом:
# DATA_BUCKET=ekp-parser-data
# YC_IAM_TOKEN=$(yc iam create-token)

# Пароль входа в интерфейс. Не задан — вход не требуется (только для локальной разработки).
# APP_PASSWORD=
# Подпись cookie сессии (любая длинная случайная строка).
# SESSION_SECRET=
# Секрет для /api/cron/sync (timer-триггер присылает его в заголовке x-cron-secret).
# CRON_SECRET=

# Региональные отделения ФСП (pnpm sync regional):
# сервисный ключ приложения VK — без него группы VK пропускаются, собираются только Telegram-каналы.
# VK_SERVICE_TOKEN=
# ключ Claude API для извлечения мероприятий из постов (claude-haiku-4-5-20251001); без него — правила.
# ANTHROPIC_API_KEY=
